<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="#415472"/>
        <Setter Property="Background" Value="#F1F5FF"/>
        <Setter Property="BorderBrush" Value="#E1E8F5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#E5EFFF"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Background" Value="#DAE8FC"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#5478BD"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#415472"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Background="Transparent" MinHeight="40">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0" RecognizesAccessKey="True"/>
                    <Border x:Name="Track" Grid.Column="1" Width="44" Height="25" CornerRadius="13" Background="#DEE5F0" VerticalAlignment="Center">
                        <Ellipse x:Name="Knob" Fill="White" Width="19" Height="19" HorizontalAlignment="Left" Margin="3"/>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#7A9EDC"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#233D72"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="#FCFDFF"/><Setter Property="Foreground" Value="#415472"/>
        <Setter Property="BorderBrush" Value="#E1E8F5"/><Setter Property="Padding" Value="10,7"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
            <Grid>
                <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                        <Border Background="#FCFDFF" BorderBrush="#E1E8F5" BorderThickness="1" CornerRadius="8">
                            <TextBlock Text="⌄" FontSize="16" Foreground="#647696" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,4"/>
                        </Border>
                    </ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,7,30,7" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="White" BorderBrush="#E1E8F5" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280">
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="8,7"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Item" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#F1F5FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#E5EFFF"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Margin" Value="0,7,0,12"/><Setter Property="MinHeight" Value="26"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
            <Track x:Name="PART_Track" Margin="2,0" VerticalAlignment="Center" Height="22">
                <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="#7A9EDC"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Width="18" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#7A9EDC" Stroke="White" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="#E1E8F5"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
            </Track>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="FishNavigationStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Nav" Background="{TemplateBinding Background}" CornerRadius="13" Padding="{TemplateBinding Padding}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#88A3CC" VerticalAlignment="Center"/>
                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="#EAF2FF"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Nav" Property="BorderBrush" Value="#98B3E0"/><Setter TargetName="Nav" Property="BorderThickness" Value="1"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="#415472"/><Setter Property="Background" Value="#FCFDFF"/>
        <Setter Property="BorderBrush" Value="#E1E8F5"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="36"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
            <Border x:Name="Input" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Input" Property="BorderBrush" Value="#99B5E5"/><Setter TargetName="Input" Property="Background" Value="White"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FishPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#6F95D9"/><Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Primary" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Primary" Property="Background" Value="#5A82CA"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Primary" Property="Background" Value="#4A73BC"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Primary" Property="BorderBrush" Value="#375A94"/><Setter TargetName="Primary" Property="BorderThickness" Value="1"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FishChoiceStyle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="13,11"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="Choice" Background="#EDFFFFFF" BorderBrush="#DCE6F6" BorderThickness="1" CornerRadius="13" Padding="{TemplateBinding Padding}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Ellipse Stroke="#A2B9DC" StrokeThickness="1.5" Fill="White"/>
                        <Ellipse x:Name="SelectedDot" Width="8" Height="8" Fill="#7398DA" Visibility="Collapsed"/>
                    </Grid>
                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="#EFF5FF"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Choice" Property="Background" Value="#DFEBFF"/><Setter TargetName="Choice" Property="BorderBrush" Value="#94B0E2"/><Setter TargetName="SelectedDot" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="#638BCC"/><Setter TargetName="Choice" Property="BorderThickness" Value="2"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FishCaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="38"/><Setter Property="Height" Value="30"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="11"/>
        <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Caption" Background="{TemplateBinding Background}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Caption" Property="Background" Value="#E5EDF9"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Caption" Property="Background" Value="#D7E4F8"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <ControlTemplate x:Key="FishSettingsWindowTemplate" TargetType="Window">
        <!-- The HWND owns the outer rounding. Paint its entire client rectangle so
             WPF does not expose an unpainted crescent behind a second rounded frame. -->
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="#DCE5F3" BorderThickness="1">
            <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border x:Name="CaptionArea" Background="#FFFDF9" BorderBrush="#E9EDF7" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,140,0" IsHitTestVisible="False">
                            <TextBlock Text="✦" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="#9AB4DF" Margin="0,0,9,0"/>
                            <TextBlock Text="{TemplateBinding Tag}" FontSize="20" Foreground="#6B83AC"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Button x:Name="Minimize" Style="{StaticResource FishCaptionButton}" Content="&#xE921;" ToolTip="最小化" AutomationProperties.Name="最小化" shell:WindowChrome.IsHitTestVisibleInChrome="True" Command="{x:Static SystemCommands.MinimizeWindowCommand}"/>
                            <Button x:Name="Maximize" Style="{StaticResource FishCaptionButton}" Content="&#xE922;" ToolTip="最大化" AutomationProperties.Name="最大化或还原" shell:WindowChrome.IsHitTestVisibleInChrome="True" Command="{x:Static SystemCommands.MaximizeWindowCommand}"/>
                            <Button x:Name="Close" Style="{StaticResource FishCaptionButton}" Content="&#xE711;" Foreground="#B98692" ToolTip="关闭设置" AutomationProperties.Name="关闭设置" shell:WindowChrome.IsHitTestVisibleInChrome="True" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <AdornerDecorator Grid.Row="1"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/></AdornerDecorator>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="WindowState" Value="Maximized">
                <Setter TargetName="Frame" Property="CornerRadius" Value="0"/><Setter TargetName="CaptionArea" Property="CornerRadius" Value="0"/>
                <Setter TargetName="Maximize" Property="Content" Value="&#xE923;"/><Setter TargetName="Maximize" Property="ToolTip" Value="还原"/>
                <Setter TargetName="Maximize" Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Style.Triggers><Trigger Property="Orientation" Value="Vertical">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#CEDBF0" CornerRadius="4" Margin="2,1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                </Track>
            </ControlTemplate></Setter.Value></Setter>
        </Trigger></Style.Triggers>
    </Style>
</ResourceDictionary>
